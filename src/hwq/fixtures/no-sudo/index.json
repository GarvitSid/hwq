{
  "schema": 1,
  "name": "no-sudo",
  "synthetic": true,
  "entries": {
    "cmd:lscpu -J": {
      "file": "lscpu.json",
      "status": "ok",
      "exit_code": 0
    },
    "cmd:dmidecode -t memory": {
      "file": "dmidecode_memory.txt",
      "status": "permission_denied",
      "exit_code": 1,
      "privileged": true,
      "stderr": "sudo: a password is required"
    },
    "file:/proc/meminfo": {
      "file": "meminfo.txt",
      "status": "ok",
      "exit_code": 0
    }
  }
}
