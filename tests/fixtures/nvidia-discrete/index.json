{
  "schema": 1,
  "name": "nvidia-discrete",
  "synthetic": true,
  "entries": {
    "cmd:lscpu -J": {
      "file": "lscpu.json",
      "status": "ok",
      "exit_code": 0
    },
    "cmd:lspci -mm -nn": {
      "file": "lspci.txt",
      "status": "ok",
      "exit_code": 0
    },
    "cmd:nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader,nounits": {
      "file": "nvidia_smi.txt",
      "status": "ok",
      "exit_code": 0
    },
    "file:/proc/meminfo": {
      "file": "meminfo.txt",
      "status": "ok",
      "exit_code": 0
    }
  }
}
